# ══════════════════════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO — MUNICIPALIDAD PROVINCIAL DE HUAMANGA
# Sistema de Gestión de Licencias de Funcionamiento
# ══════════════════════════════════════════════════════════════════════════════
# Copie este archivo a .env y configure los valores según su entorno:
# cp .env.example .env

# Base de Datos PostgreSQL
POSTGRES_DB=muni_licencias_db
POSTGRES_USER=muni_user
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION_PASSWORD_ROBUSTO_123!
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/muni_licencias_db
SPRING_DATASOURCE_USERNAME=muni_user
SPRING_DATASOURCE_PASSWORD=CAMBIAR_EN_PRODUCCION_PASSWORD_ROBUSTO_123!

# Consola Administrativa pgAdmin (Opcional)
PGADMIN_DEFAULT_EMAIL=admin@munihuamanga.gob.pe
PGADMIN_DEFAULT_PASSWORD=CAMBIAR_EN_PRODUCCION_PGADMIN_PASS!

# Seguridad y Autenticación JWT (Mínimo 256 bits / 32 caracteres)
# OBLIGATORIO cambiar en entorno de producción:
JWT_SECRET=MunicipalidadProvincialDeHuamangaGestionLicenciasSecretKeySegura2026!
JWT_EXPIRATION_MS=28800000

# Perfil de Ejecución Spring Boot (local | dev | test | prod)
SPRING_PROFILES_ACTIVE=local

# Notificaciones y Servidor SMTP
MAIL_ENABLED=false
MAIL_HOST=smtp.munihuamanga.gob.pe
MAIL_PORT=587
MAIL_USERNAME=notificaciones@munihuamanga.gob.pe
MAIL_PASSWORD=CAMBIAR_EN_PRODUCCION_PASSWORD_CORREO

# URLs Institucionales y Portales Web
PORTAL_URL=http://localhost:8081
PORTAL_VERIFICACION_URL=http://localhost:8081/verificar-licencia.html?codigo=
